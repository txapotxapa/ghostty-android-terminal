<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- apt/curl/… inside the userland run as the app's uid. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Keep the process alive (and shells running) while backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Persistent notification for the foreground service (runtime on 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional CPU wake lock so background jobs keep running with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Terminal bell haptic feedback. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Self-updates from GitHub Releases (AppUpdater). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- One-time prompt to exempt the app from Doze battery optimization. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Optional storage bind mounts for userland sessions. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Terminal"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- QR SSH pairing links from tools/a-sh-pair (SshLinks). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ash" android:host="ssh" />
            </intent-filter>
            <!-- Share a screenshot (or any file) to an agent or a terminal tab. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <!-- The file the camera writes a photo into (composer + → Camera). -->
        <provider
            android:name=".ui.CaptureProvider"
            android:authorities="${applicationId}.capture"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- First-run intro & userland setup wizard, launched by MainActivity
             for the first session and again (setup-only mode) on demand. -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />

        <!-- App settings screen, launched from the nav bar's Settings item. -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- Terminal theme editor, launched from Settings. -->
        <activity
            android:name=".ui.ThemeActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- Extra-keys toolbar editor, launched from Settings. -->
        <activity
            android:name=".ui.ExtraKeysActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- PackageInstaller session results for self-updates (AppUpdater). -->
        <receiver
            android:name=".ui.AppUpdater$InstallResultReceiver"
            android:exported="false" />

        <!-- Holds the process at foreground priority while shells run.
             stopWithTask=false keeps it (and the shells) alive when the
             task is swiped from Recents. -->
        <service
            android:name=".term.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps interactive terminal shells and their child processes running while the app is in the background." />
        </service>
    </application>

</manifest>
